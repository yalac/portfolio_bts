---
import { Image } from "astro:assets";
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import PhotoProfil from "/public/imgs/ImageProfil.jpg";
---

<header>
    <nav>
        <a href="/" class="profile-link">
            <Image src={PhotoProfil} alt="Photo de profil" height={51} width={51} />
            <span class="name">LACAILLE Yanis</span>
        </a>
        <Hamburger />
        <Navigation />
    </nav>
</header>

<style>
    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px;
    }

    .profile-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: #e6e6e6;
    }

    .profile-link img {
        border-radius: 50px;
        object-fit: cover;
        margin-right: 8px;
    }

    .name {
        font-weight: bold;
        font-style: italic;
        font-size: 20px;
    }
</style>
