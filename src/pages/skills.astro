---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageBidon1 from "/public/imgs/imageBidon1.png";
import ImageBidon2 from "/public/imgs/imageBidon2.png";
---

<BaseLayout>
    <h1>Résumé de mes compétence</h1>
    <h2>Épreuve E5</h2>
    <h3>Voici mon tableau de synthèse joint <a href="/YLA_TableauDeSynthese.xlsx" target="_blank">ici</a></h3>
    <h3>Attestion de stage</h3>
    <ul class="skills-list">
        <li>
            <div class="images-row">
                <div class="img">
                    1<sup>ère</sup> année de BTS SIO option SLAM
                    <div>
                        <Image src={ImageBidon1} alt="Photo de profil" height={320} width={240} />
                    </div>
                </div>
                <div class="img">
                    2<sup>nd</sup> année de BTS SIO option SLAM
                    <div>
                        <Image src={ImageBidon2} alt="Photo de profil" height={320} width={240} />
                    </div>
                </div>
            </div>
        </li>
    </ul>

    <h2>Épreuve E6</h2>
</BaseLayout>

<style>
    h2 {
        color: #a64dff;
        margin-top: 20px;
        text-align: center;
        font-size: 30px;
    }

    h3 {
        color: #e6e6e6;
        text-align: center;
        font-size: 20px;
        margin-top: 20px;
        margin-bottom: 5px;
    }

    .skills-list {
        list-style: none;
        text-align: center;
        margin: 32px auto 32px;
    }

    .images-row {
        display: flex;
        gap: 50px;
    }

    .skills-list li {
        font-size: 17px;
    }

    .skills-list .img {
        background-color: #333;
        padding: 20px;
        border-radius: 20px;
    }

    a {
        color: #a64dff;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }
</style>
