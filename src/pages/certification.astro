---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <h1>Mes certifications</h1>
    <h2>Voici la liste de toutes mes certifications.</h2>
    <ul>
        <li>
            <h3><a href="https://atelier-rgpd.cnil.fr/" target="_blank">Atelier RGPD</a></h3>
            <p>Module 1</p>
            <img src="/src/imgs/CertificationRGPDm1.png" height="480" width="640" />
            <p>Module 2</p>
            <img src="/src/imgs/CertificationRGPDm2.png" height="480" width="640" />
            <p>Module 3</p>
            <img src="/src/imgs/CertificationRGPDm3.png" height="480" width="640" />
            <p>Module 4</p>
            <img src="/src/imgs/CertificationRGPDm4.png" height="480" width="640" />
            <p>Module 5</p>
            <img src="/src/imgs/CertificationRGPDm5.png" height="480" width="640" />
            <p>Module 6 (bientôt)</p>
        </li>
        <li>
            <h3><a href="https://secnumacademie.gouv.fr/auth/login" target="_blank">MOOC de l'ANSSI</a></h3>
            <img src="/src/imgs/CertificationANSSI.png" height="480" width="640" />
        </li>
        <li>
            <h3><a href="https://app.pix.fr/connexion" target="_blank">Pix</a></h3>
            <p>(bientôt)<p></p></p>
        </li>
    </ul>
</BaseLayout>

<style>
    p,
    img {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        margin-bottom: 10px;
    }
    a {
        color: #e6e6e6;
    }
</style>
