---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageAttestation1 from "/public/documents/attestations/attestationStagePremiere.png";
import ImageAttestation2 from "/public/documents/attestations/attestationStageDeuxieme.png";

const sections = [
    { id: "epreuve-e5", label: "Épreuve E5" },
    { id: "epreuve-e6", label: "Épreuve E6" },
];
---

<BaseLayout sections={sections}>
    <h1>Résumé de mes compétences</h1>
    <h2 id="epreuve-e5">Épreuve E5</h2>
    <h3>Voici mon tableau de synthèse joint <a href="/documents/tableaux/YLA_TableauDeSynthese.xlsx" target="_blank">ici</a></h3>
    <h3>Attestation de stage</h3>
    <ul class="skills-list">
        <li>
            <div class="images-row">
                <div class="img">
                    1<sup>ère</sup> année de BTS SIO option SLAM
                    <div>
                        <a href="/documents/attestations/attestationStagePremiere.png" target="_blank" title="Attestation stage 1ère année">
                            <Image src={ImageAttestation1} alt="Attestation de stage 1ère année" height={480} width={360} />
                        </a>
                    </div>
                </div>
                <div class="img">
                    2<sup>nde</sup> année de BTS SIO option SLAM
                    <div>
                        <a href="/documents/attestations/attestationStageDeuxieme.png" target="_blank" title="Attestation stage 2nde année">
                            <Image src={ImageAttestation2} alt="Attestation de stage 2nde année" height={480} width={360} />
                        </a>
                    </div>
                </div>
            </div>
        </li>
    </ul>

    <h2 id="epreuve-e6">Épreuve E6</h2>
</BaseLayout>

<style>
    h2 {
        color: #a64dff;
        margin-top: 20px;
        text-align: center;
        font-size: 30px;
    }

    h3 {
        color: #e6e6e6;
        text-align: center;
        font-size: 20px;
        margin-top: 20px;
        margin-bottom: 5px;
    }

    .skills-list {
        list-style: none;
        text-align: center;
        margin: 32px auto 32px;
    }

    .images-row {
        display: flex;
        gap: 50px;
    }

    .skills-list li {
        font-size: 17px;
    }

    .skills-list .img {
        background-color: #333;
        padding: 20px;
        border-radius: 20px;
    }

    a {
        color: #a64dff;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }
</style>
