---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageAttestation1 from "/public/documents/attestations/attestationStagePremiere.png";
import ImageAttestation2 from "/public/documents/attestations/attestationStageDeuxieme.png";

const sections = [
    { id: "epreuve-e5", label: "Épreuve E5" },
    { id: "epreuve-e6", label: "Épreuve E6" },
];
---

<BaseLayout sections={sections}>
    <h1>📁 Résumé de mes compétences</h1>
    <details class="accordion rectorat-panel page-card" open>
        <summary>
            <h2 id="epreuve-e5">Épreuve E5</h2>
        </summary>
        <div class="tableau-card rectorat-card">
            <h3>Tableau de synthèse</h3>
            <p>Fichier : <a href="/documents/tableaux/YLA_TableauDeSynthese.xlsx">YLA_TableauDeSynthese.xlsx</a></p>
            <p>N° candidat : <span class="candidate-number">02248359720</span></p>
        </div>
        <div class="rectorat-stack">
            <h3>Attestation de stage</h3>
            <ul class="skills-list">
                <li>
                    <div class="images-row">
                        <figure class="img">
                            <figcaption>1<sup>ère</sup> année de BTS SIO option SLAM</figcaption>
                            <a href="/documents/attestations/attestationStagePremiere.png" title="Attestation stage 1ère année">
                                <Image src={ImageAttestation1} alt="Attestation de stage 1ère année" height={480} width={360} />
                            </a>
                        </figure>
                        <figure class="img">
                            <figcaption>2<sup>nde</sup> année de BTS SIO option SLAM</figcaption>
                            <a href="/documents/attestations/attestationStageDeuxieme.png" title="Attestation stage 2nde année">
                                <Image src={ImageAttestation2} alt="Attestation de stage 2nde année" height={480} width={360} />
                            </a>
                        </figure>
                    </div>
                </li>
            </ul>
        </div>
    </details>

    <details class="accordion rectorat-panel page-card">
        <summary>
            <h2 id="epreuve-e6">Épreuve E6</h2>
        </summary>
        <div class="rectorat-stack">
            <h3>FDRP (Fiche de rendu de projet)</h3>
            <p class="rectorat-center">Ma 1<sup>ère</sup> FDRP : <a href="/portfolio/RPCours/FDRPUne">Voir la FDRP</a> | <a href="/documents/tableaux/YLA_FDRP_SLAM_1.pdf" target="_blank"> (Version PDF)</a></p>
            <p class="rectorat-center">Ma 2<sup>nde</sup> FDRP : <a href="/portfolio/RPCours/FDRPDeux">Voir la FDRP</a> | <a href="/documents/tableaux/YLA_FDRP_SLAM_2.pdf" target="_blank"> (Version PDF)</a></p>
        </div>
    </details>
</BaseLayout>

<style>
    h2 {
        color: #a64dff;
        margin-top: 0;
        text-align: center;
        font-size: 30px;
    }

    h3 {
        color: #ffd780;
        text-align: center;
        font-size: 20px;
        margin: 18px 0 8px;
    }

    .rectorat-panel {
        max-width: 1100px;
        margin: 0 auto 18px;
    }

    .rectorat-stack {
        display: grid;
        gap: 14px;
    }

    .rectorat-center {
        text-align: center;
        margin: 0;
        color: #e6e6e6;
    }

    .skills-list {
        list-style: none;
        text-align: center;
        margin: 0;
        padding: 0;
    }

    .images-row {
        display: flex;
        gap: 18px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .skills-list li {
        font-size: 17px;
    }

    .skills-list .img {
        background: linear-gradient(180deg, #222232, #17171d);
        padding: 18px;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.08);
        display: grid;
        gap: 12px;
        justify-items: center;
    }

    .skills-list figcaption {
        font-weight: 700;
        color: #f1eff8;
    }

    .skills-list img {
        border-radius: 12px;
        box-shadow: 0 10px 26px rgba(0,0,0,0.18);
    }

    a {
        color: #a64dff;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .tableau-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.12));
        padding: 18px;
        border-radius: 14px;
        max-width: 520px;
        margin: 0 auto 20px;
    }

    .rectorat-panel > .tableau-card {
        margin-top: 18px;
    }

    .tableau-card h3 {
        margin: 0 0 8px 0;
        color: #ffd780;
    }

    .candidate-number {
        font-weight: 700;
        color: #ffb3b3;
    }
</style>
