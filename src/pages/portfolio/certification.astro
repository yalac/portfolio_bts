---
import {Image} from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CertificationANSSI from "/public/images/certifications/CertificationANSSI.png";
import CertificationPix from "/public/images/certifications/CertificationPixLvlA1.png";
import CertificationRGPDm1 from "/public/images/certifications/CertificationRGPDm1.png";
import CertificationRGPDm2 from "/public/images/certifications/CertificationRGPDm2.png";
import CertificationRGPDm3 from "/public/images/certifications/CertificationRGPDm3.png";
import CertificationRGPDm4 from "/public/images/certifications/CertificationRGPDm4.png";
import CertificationRGPDm5 from "/public/images/certifications/CertificationRGPDm5.png";
import CertificationRGPDm6 from "/public/images/certifications/CertificationRGPDm6.png";

const sections = [
    { id: "atelier-rgpd", label: "Atelier RGPD" },
    { id: "mooc-anssi", label: "MOOC de l'ANSSI" },
    { id: "pix", label: "Pix" },
];
---

<BaseLayout sections={sections}>
    <h1>Mes certifications</h1>
    <h2>Voici la liste de toutes mes certifications.</h2>
    <ul>
        <li id="atelier-rgpd">
            <h3><a href="https://atelier-rgpd.cnil.fr/" target="_blank">Atelier RGPD</a></h3>
            <p>Module 1</p>
            <Image src={CertificationRGPDm1} alt="Certification RGPD Module 1" height={480} width={640} />
            <p>Module 2</p>
            <Image src={CertificationRGPDm2} alt="Certification RGPD Module 2" height={480} width={640} />
            <p>Module 3</p>
            <Image src={CertificationRGPDm3} alt="Certification RGPD Module 3" height={480} width={640} />
            <p>Module 4</p>
            <Image src={CertificationRGPDm4} alt="Certification RGPD Module 4" height={480} width={640} />
            <p>Module 5</p>
            <Image src={CertificationRGPDm5} alt="Certification RGPD Module 5" height={480} width={640} />
            <p>Module 6</p>
            <Image src={CertificationRGPDm6} alt="Certification RGPD Module 6" height={480} width={640} />
        </li>
        <li id="mooc-anssi">
            <h3><a href="https://secnumacademie.gouv.fr/auth/login" target="_blank">MOOC de l'ANSSI</a></h3>
            <Image src={CertificationANSSI} alt="Certification ANSSI" height={480} width={640} />
        </li>
        <li id="pix">
            <h3><a href="https://app.pix.fr/connexion" target="_blank">Pix</a></h3>
            <Image src={CertificationPix} alt="Certification Pix" height={480} width={640} />
        </li>
    </ul>
</BaseLayout>

<style>
    p,
    img {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        margin-bottom: 10px;
    }
    a {
        color: #e6e6e6;
    }
</style>
